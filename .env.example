# Application Configuration
APP_NAME="Padi REST API Go"
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
APP_KEY=padi-super-secret-key-change-in-production

# Authentication / JWT
JWT_SECRET=padi-jwt-secret-key-32-chars-long-min
JWT_EXPIRATION=24

# Database Configuration (sqlite | mysql | postgres)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

# Security & CORS
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
